# WEEHS OHS Hub — destination URLs for each app tile.
# Set these in Vercel (Project → Settings → Environment Variables) to point the
# tiles at your real deployments. If unset, the placeholder defaults in
# src/apps.config.js (*.vercel.app) are used.

VITE_FIRE_MARSHAL_URL=https://fire-marshal.vercel.app
VITE_HIRA_URL=https://hira.vercel.app
VITE_INCIDENT_IRA_URL=https://incident-ira.vercel.app
VITE_INSPECTIONS_URL=https://inspections-portal.vercel.app
VITE_INTERNAL_AUDIT_URL=https://internal-audit-portal.vercel.app
VITE_HECP_LOTO_URL=https://hecp-loto.vercel.app
VITE_HSE_COMMITTEE_URL=https://hse-committee-meeting.vercel.app
VITE_PERMIT_TO_WORK_URL=https://permit-to-work.vercel.app
